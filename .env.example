# ==========================================
# LEADFLOW - CONFIGURACIÓN GENERAL
# ==========================================

PROJECT_NAME=LeadFlow
VERSION=0.1.0-alpha
ENVIRONMENT=development
API_PORT=8000
TIMEZONE=America/Bogota

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# JWT (Futuro)
# ==========================================

SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# OPENAI (Futuro)
# ==========================================

OPENAI_API_KEY=

# ==========================================
# WHATSAPP (Futuro)
# ==========================================

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ==========================================
# EMAIL (Futuro)
# ==========================================

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==========================================
# GOOGLE PLACES (sourcing de prospectos)
# ==========================================

GOOGLE_PLACES_API_KEY=

# Tipo de negocio objetivo por defecto cuando el sourcing se dispara
# sin parámetros explícitos (ej. Cron Trigger semanal de n8n). Debe
# ser un valor válido del enum TipoNegocio.
SOURCING_TIPO_NEGOCIO_DEFAULT=PIZZERIA

# Tope de prospectos "en proceso" (CONTACTADO/RESPONDIO/INTERESADO/
# COTIZADO/NEGOCIACION) antes de que el orquestador de primer contacto
# deje de mandar mensajes nuevos, sin importar cuántos NUEVO haya en
# cola.
TOPE_EMBUDO_ACTIVO=50

# ==========================================
# NEGOCIO (personalizar por cliente)
# ==========================================
# Arquitectura de instancia separada por cliente: cada cliente nuevo
# corre su propia instancia de este proyecto con su propio .env. Para
# adaptar el agente a un negocio distinto, llená estas 4 variables —
# no hace falta tocar código Python.

BUSINESS_NAME=Mi Empresa
BUSINESS_TYPE=distribuidor de repuestos industriales
BUSINESS_DESCRIPTION=Vendemos repuestos y accesorios para maquinaria industrial.
BUSINESS_TONE=profesional y directo, sin emojis

# ==========================================
# LEADFLOW CONTROL (administración de cuentas)
# ==========================================
# CONTROL_BASE_URL: URL donde vive la instancia de LeadFlow Control.
# EMPRESA_API_KEY: la que Control generó al dar de alta esta empresa
# (se copia una sola vez desde el panel de Control al crearla).

CONTROL_BASE_URL=
EMPRESA_API_KEY=