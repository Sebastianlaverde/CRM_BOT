# ==========================================
# LEADFLOW - CONFIGURACIÓN GENERAL
# ==========================================

PROJECT_NAME=LeadFlow
VERSION=0.1.0-alpha
ENVIRONMENT=development
API_PORT=8000
TIMEZONE=America/Bogota

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_DB=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# JWT (Futuro)
# ==========================================

SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# OPENAI (Futuro)
# ==========================================

OPENAI_API_KEY=

# ==========================================
# WHATSAPP (Futuro)
# ==========================================

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ==========================================
# EMAIL (Futuro)
# ==========================================

SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=